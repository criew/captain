# Captain – Betrieb mit compose.deploy.yml. Kopieren nach .env (gitignored):
#   cp .env.example .env && chmod 600 .env
# Nach Änderungen: docker compose -f compose.deploy.yml up -d

# --- Ablage ------------------------------------------------------------------
# Host-Verzeichnis für Config, Bot-Daten, Session-Verzeichnisse und
# opencode-Daten (Backup-Ziel). Wird beim ersten Start angelegt (root).
CAPTAIN_HOME=/opt/captain

# --- Mattermost ---------------------------------------------------------------
# Basis-URL, wie der Bot-Rechner Mattermost erreicht (HTTPS + WebSocket).
MM_URL=https://chat.example.org
# Access Token des Bot-Accounts (System Console → Integrationen → Bot-Accounts).
MM_BOT_TOKEN=

# --- opencode -----------------------------------------------------------------
# Passwort zwischen Bot und opencode (Basic-Auth, Benutzer "opencode").
# Beliebiger langer Zufallswert, z. B.: openssl rand -hex 24
OPENCODE_SERVER_PASSWORD=

# --- Modell: OpenAI-kompatibler Endpunkt (Provider "llm") --------------------
# vLLM:       https://vllm.example.org/v1   (Tool-Calling serverseitig an:
#             --enable-auto-tool-choice --tool-call-parser <parser>)
# Open WebUI: https://webui.example.org/api (API-Key: Einstellungen → Konto)
# Ollama:     http://host.docker.internal:11434/v1 (Token beliebig)
LLM_BASE_URL=https://vllm.example.org/v1
LLM_API_KEY=
# Modellname beim Server (vLLM: --served-model-name, Open WebUI: Modell-ID).
LLM_MODEL=
# Standardmodell provider/modell; Default llm/$LLM_MODEL. Nur setzen, wenn
# ein anderer Provider aus $CAPTAIN_HOME/config/opencode.jsonc gelten soll.
# OPENCODE_MODEL=
# OPENCODE_VARIANT=

# Optional statt/zusätzlich: API-Keys von Cloud-Providern (opencode kennt sie
# ohne weitere Config), dann OPENCODE_MODEL z. B. anthropic/claude-sonnet-4-5.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Persona ------------------------------------------------------------------
# Systemnachricht jeder neuen Session (Default: neutrale Captain-Beschreibung).
# CAPTAIN_SYSTEM_PROMPT="Du bist Captain, der hilfsbereite Assistent des Teams."
# Oder als Datei (Vorrang), z. B. $CAPTAIN_HOME/config/persona.md:
# CAPTAIN_SYSTEM_PROMPT_FILE=/config/persona.md

# --- Verhalten ----------------------------------------------------------------
# Nur diese Mattermost-Nutzer (kommagetrennt); leer = alle.
# ALLOWED_USERS=alice,bob
# Nachrichten, die während einer Pause des Bots kamen, höchstens so alt
# nachholen (Sekunden oder 90m, 24h, 2d; 0 = nichts nachholen; Default 24h).
# CATCHUP_MAX_AGE=24h
# Vorgeschichte einer neuen Kanal-Unterhaltung (Top-Level-Erwähnung):
# höchstens so viele Posts / Zeichen, die neuesten gewinnen (0 = keine).
# HISTORY_MAX_POSTS=50
# HISTORY_MAX_CHARS=8000
# Größter Anhang in MB, der geladen und an opencode gegeben wird (0 = keine Grenze).
# MAX_ATTACHMENT_MB=20
# LOG_LEVEL=INFO

# --- webfetch (optional) -------------------------------------------------------
# Kommagetrennte URL-Präfixe, die das Modell per webfetch lesen darf (jeweils
# genau dieser Host und Pfade darunter). Leer = kein Internet-Zugriff.
# Gilt für neue Sessions (!neu); Risiken: README „webfetch für bestimmte URLs
# erlauben“. Beispiel:
# CAPTAIN_WEBFETCH_ALLOW=http://text-example.org

# --- Geteiltes Verzeichnis (optional) ------------------------------------------
# Host-Verzeichnis, dessen Dateien Captain in ALLEN Chats lesen (nicht ändern)
# darf; im Container unter /shared, schreibgeschützt. Leer = aus. Empfohlen:
# $CAPTAIN_HOME/shared/… (andere Orte unter CAPTAIN_HOME sind verboten), sonst
# ein absoluter Pfad, nicht / oder ein Systemverzeichnis. Keine Symlinks,
# Mounts, Bare-Repos oder Zugangsdaten darin (sonst startet opencode nicht);
# .git wird nie gelesen, Git-Repos nur als normale Clones
# (git clone -c core.symlinks=false). Änderungen an den Dateien sind ohne
# Neustart sichtbar. Text ja, PDF/Office nein. Risiken: README „Geteiltes
# Verzeichnis (nur lesen)“. Beispiel:
# CAPTAIN_SHARED_DIR=/opt/captain/shared/infos
# Grenzen der Prüfung (darüber startet opencode nicht), Default 100000 / 5:
# CAPTAIN_SHARED_MAX_ENTRIES=100000
# CAPTAIN_SHARED_MAX_SECONDS=5

# --- Proxy (optional) ------------------------------------------------------------
# Ausgehende Verbindungen von Bot und opencode (Mattermost, LLM, MCP) über einen
# Proxy. Bewusst eigene Namen: HTTP_PROXY aus Shell/~/.docker/config.json wird
# NICHT übernommen. Der Proxy muss aus dem Container erreichbar sein (IP oder
# per DNS auflösbarer Name). Bot → opencode geht nie über den Proxy.
# CAPTAIN_HTTP_PROXY=http://10.0.0.1:3128
# CAPTAIN_HTTPS_PROXY=http://10.0.0.1:3128
# Zusätzlich direkt erreichbare Ziele (kommagetrennt), z. B. internes Mattermost/LLM:
# CAPTAIN_NO_PROXY=chat.example.org,llm.intern

# --- Eigene CA (optional) -------------------------------------------------------
# Bei „unable to verify the first certificate“ / UNABLE_TO_VERIFY_LEAF_SIGNATURE
# im opencode-Log: CA-Datei (PEM, darf mehrere Zertifikate enthalten) nach
# $CAPTAIN_HOME/config/ legen und hier nur den Dateinamen eintragen.
# CAPTAIN_CA_FILE=ca.pem

# MCP-Server-Geheimnisse stehen NICHT hier, sondern in mcp.env (Vorlage
# mcp.env.example) – die bekommt nur der opencode-Container.
