# Kopieren nach infra/opencode/.env (gitignored) und Werte anpassen.

# Basic-Auth des opencode-Servers: Benutzer "opencode", Passwort hier.
# Ohne diesen Wert erzeugt opencode bei jedem Start ein zufaelliges Passwort.
OPENCODE_SERVER_PASSWORD=bitte-aendern

# Default-Modell im Format provider/model.
# Standard: lokales Ollama auf dem Docker-Host (kein API-Key noetig).
OPENCODE_MODEL=ollama/gemma4:e4b
# OPENCODE_MODEL=ollama/qwen3:4b          # denkt oft minutenlang, siehe README
# OPENCODE_MODEL=opencode/big-pickle       # opencode Zen Free, ohne Key, Cloud
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5

# OpenAI-kompatibler Endpunkt von Ollama, vom Container aus gesehen.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optionale API-Keys fuer Cloud-Provider (leer lassen, wenn nicht genutzt).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# opencode Zen / Go
# OPENCODE_API_KEY=

# --- Captain-Bot (liest diese Datei ebenfalls als env_file) ---
# webfetch-Allowlist fuer Bot (Session-Regeln) und opencode (Policies,
# Egress-Filter); leer = webfetch aus. Siehe README.
# CAPTAIN_WEBFETCH_ALLOW=http://text-example.org
# Persona/Systemnachricht jeder neuen Session (Default: neutrale Captain-Beschreibung).
# CAPTAIN_SYSTEM_PROMPT="Du bist CaptainSuperman, der helfende Bot, und hast eine lustige Persoenlichkeit."
# Alternativ Pfad zu einer Textdatei im Bot-Container (hat Vorrang):
# CAPTAIN_SYSTEM_PROMPT_FILE=/data/persona.txt
